{
  "name": "aerie",
  "version": "0.0.1",
  "description": "One config file → typed CRUD + auth on Cloudflare Workers (or anywhere).",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./drizzle": {
      "types": "./src/engine/drizzle.ts",
      "default": "./src/engine/drizzle.ts"
    },
    "./route": {
      "types": "./src/engine/route.ts",
      "default": "./src/engine/route.ts"
    },
    "./engine": {
      "types": "./src/engine/build.ts",
      "default": "./src/engine/build.ts"
    },
    "./types": {
      "types": "./src/engine/types.ts",
      "default": "./src/engine/types.ts"
    },
    "./platform": {
      "types": "./src/engine/platform.ts",
      "default": "./src/engine/platform.ts"
    },
    "./adapters/cloudflare": {
      "types": "./src/adapters/cloudflare.ts",
      "default": "./src/adapters/cloudflare.ts"
    },
    "./adapters/node-sqlite": {
      "types": "./src/adapters/node-sqlite.ts",
      "default": "./src/adapters/node-sqlite.ts"
    },
    "./adapters/fs-storage": {
      "types": "./src/adapters/fs-storage.ts",
      "default": "./src/adapters/fs-storage.ts"
    }
  },
  "files": [
    "src",
    "migrations",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "migrate:local": "wrangler d1 migrations apply aerie --local",
    "migrate:remote": "wrangler d1 migrations apply aerie --remote"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.0",
    "jose": "^5.9.0",
    "jsep": "^1.4.0",
    "kysely": "^0.27.4",
    "kysely-d1": "^0.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240821.0",
    "@types/better-sqlite3": "^7.6.11",
    "better-sqlite3": "^11.3.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "wrangler": "^3.72.0"
  }
}
