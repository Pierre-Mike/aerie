{
  "name": "aerie",
  "version": "0.0.1",
  "description": "One config file → typed CRUD + auth on Cloudflare Workers (or anywhere).",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "migrate:local": "wrangler d1 migrations apply aerie --local",
    "migrate:remote": "wrangler d1 migrations apply aerie --remote"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "jose": "^5.9.0",
    "jsep": "^1.4.0",
    "kysely": "^0.27.4",
    "kysely-d1": "^0.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240821.0",
    "@types/better-sqlite3": "^7.6.11",
    "better-sqlite3": "^11.3.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "wrangler": "^3.72.0"
  }
}
